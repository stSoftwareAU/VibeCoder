{
  "name": "Release tags",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/[0-9]*.[0-9]*.[0-9]*",
        "refs/tags/v[0-9]*.[0-9]*.[0-9]*"
      ],
      "exclude": [
        "refs/tags/*-*",
        "refs/tags/*+*"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "update"
    },
    {
      "type": "non_fast_forward"
    }
  ]
}
