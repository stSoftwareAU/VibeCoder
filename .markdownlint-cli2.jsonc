// markdownlint-cli2 configuration for the Vibe Coder repo (Issue #1685).
//
// Catches the broad class of Markdown syntax errors that the
// pages-liquid (#1601) and mermaid (#1683) checks miss — broken
// heading hierarchies, malformed tables, missing-space ATX headings,
// and empty links.
//
// Stylistic rules (line length, trailing whitespace, fenced-code-language,
// blank lines around fences) are intentionally disabled — they generate
// noise without catching real defects. Add structural rules here when a
// new class of breakage appears.
//
// Australian English spelling used throughout (behaviour, colour, etc.).
{
  // Files scanned by the markdownlint quality gate stage. Mirrors the
  // pages-liquid file set (AGENTS.md, README.md, SECURITY.md,
  // docs/**/*.md) so coverage is consistent across structural checks.
  "globs": [
    "AGENTS.md",
    "README.md",
    "SECURITY.md",
    "docs/**/*.md"
  ],

  // Historical/frozen content lives under docs/archive — it is not
  // relevant to ongoing quality. Keep it out so the check stays
  // signal-rich.
  "ignores": [
    "docs/archive/**",
    "node_modules/**",
    "_site/**",
    "vendor/**",
    ".jekyll-cache/**"
  ],

  // Rule selection — start from `default: false` and opt in to the
  // structural rules only.
  "config": {
    "default": false,

    // Heading hierarchy — h1 → h3 without h2 etc.
    "MD001": true,

    // Broken ATX headings: `#text` (no space), `#  text` (multi-space),
    // `#text#` / `# text  #` closed-style equivalents.
    "MD018": true,
    "MD019": true,
    "MD020": true,
    "MD021": true,

    // Link integrity: `[text]( )`, `[text]()`.
    "MD039": true,
    "MD042": true,

    // Tables: pipe-style (MD055) and column-count (MD056) catch broken
    // rows like the SECURITY.md table column miscount that ships in
    // Issue #1685's first iteration.
    "MD055": true,
    "MD056": true
  }
}
