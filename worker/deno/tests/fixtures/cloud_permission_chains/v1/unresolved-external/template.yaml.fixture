AWSTemplateFormatVersion: "2010-09-09"
Description: Pipeline role whose target and managed policy are parameters
Parameters:
  ExternalPolicyArn:
    Type: String
  TargetRoleArn:
    Type: String
Resources:
  CiRole:
    Type: AWS::IAM::Role
    Properties:
      Description: Pipeline role that assumes a role passed in as a parameter
      ManagedPolicyArns:
        - !Ref ExternalPolicyArn
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: codebuild.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: assume
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action: sts:AssumeRole
                Resource: !Ref TargetRoleArn
  AdminRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              AWS: !GetAtt CiRole.Arn
            Action: sts:AssumeRole
      Policies:
        - PolicyName: admin
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action: iam:*
                Resource: "*"
