{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "CiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Pipeline role that ships the function",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "codebuild.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "pass-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": { "Fn::GetAtt": ["RuntimeRole", "Arn"] }
                },
                {
                  "Effect": "Allow",
                  "Action": "lambda:CreateFunction",
                  "Resource": "*"
                },
                {
                  "Effect": "Deny",
                  "Action": "iam:PassRole",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "RuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "lambda.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "admin",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                { "Effect": "Allow", "Action": "iam:*", "Resource": "*" }
              ]
            }
          }
        ]
      }
    }
  }
}
