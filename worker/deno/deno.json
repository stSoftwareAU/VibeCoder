{
  "name": "@vibe-coder/worker",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test --frozen --lock=deno.lock --allow-read --allow-env --allow-run --allow-write --allow-sys=hostname",
    "test:run-mode": "deno task test tests/run_sh_launcher_test.ts tests/run_ps1_launcher_test.ts tests/launcher_parity_test.ts tests/launcher_source_test.ts tests/run_mode_test.ts tests/run_mode_ci_coverage_test.ts tests/container_launch_test.ts tests/container_runtime_test.ts tests/setup_prerequisites_test.ts",
    "audit": "deno audit",
    "check": "deno check --frozen --lock=deno.lock '**/*.ts'",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "quality": "deno run --frozen --lock=deno.lock --allow-env --allow-read --allow-run --allow-write --allow-net quality.ts",
    "setup": "deno run --frozen --lock=deno.lock --allow-all setup/setup_cli.ts",
    "audit-log-tail": "deno run --frozen --lock=deno.lock --allow-read --allow-env mod.ts audit-log-tail",
    "audit-chain-verify": "deno run --frozen --lock=deno.lock --allow-read --allow-write --allow-env mod.ts audit-chain-verify",
    "backlog-report": "deno run --frozen --lock=deno.lock --allow-read --allow-env --allow-run mod.ts backlog-report",
    "callback-conformance": "deno run --frozen --lock=deno.lock --allow-read --allow-write --allow-run --allow-env --allow-sys=hostname mod.ts callback-conformance",
    "green-gate-report": "deno run --frozen --lock=deno.lock --allow-read --allow-write --allow-env --allow-run --allow-sys=hostname mod.ts green-gate-report",
    "security-tabletop": "deno run --frozen --lock=deno.lock --allow-read --allow-write --allow-env --allow-run --allow-sys=hostname mod.ts security-tabletop",
    "publish-decision-check": "deno run --frozen --lock=deno.lock --allow-read --allow-env mod.ts publish-decision-check --repo ../..",
    "security-tree-sweep": "deno run --frozen --lock=deno.lock --allow-read --allow-write --allow-env --allow-run --allow-sys=hostname mod.ts security-tree-sweep --repo ../.. --slug stSoftwareAU/VibeCoder",
    "references-refresh": "deno run --frozen --lock=deno.lock --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys=hostname mod.ts references-refresh --repo ../.. --slug stSoftwareAU/VibeCoder"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@stsoftware/*", "npm:@stsoftware/*"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/yaml/parse": "jsr:@std/yaml@^1.0.12/parse"
  },
  "lint": {
    "rules": {
      "exclude": [
        "require-await",
        "verbatim-module-syntax"
      ]
    }
  }
}
